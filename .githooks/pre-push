#!/usr/bin/env bash
# HARD guardrail (founder 2026-08-10): a push is BLOCKED unless the full CI-equivalent passes locally,
# so `main` never goes red. Mirrors the CI `lint` + `test` jobs. Enable once per clone with `make hooks`.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

fail() { echo "❌ $1 — push BLOCKED (CI would fail). Fix it, then push again." >&2; exit 1; }

echo "[pre-push] full CI mirror: ruff · guards · mypy · tests/unit …"
uv run ruff check .            || fail "ruff"
uv run python scripts/guards.py || fail "architecture guards"
uv run mypy core               || fail "mypy core"
uv run pytest tests/unit -q    || fail "tests/unit"
echo "[pre-push] ✅ CI mirror clean — pushing"
