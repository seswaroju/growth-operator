# Copy to web/.env and fill in as needed. Vite exposes only VITE_-prefixed vars to the browser.

# Backend API base (default: http://localhost:8000).
# VITE_API_BASE=http://localhost:8000

# Error tracking (security S2). LEAVE UNSET to disable — with no DSN, no error tracking is
# initialized and nothing leaves the browser. To enable, run a local GlitchTip
# (`make glitchtip`, see infra/docker/GLITCHTIP.md) and paste its React project DSN here.
# VITE_ERROR_DSN=http://<key>@localhost:8888/1
